{
  "name": "anvil3d",
  "productName": "Anvil3D",
  "version": "0.49.0",
  "description": "Anvil3D — CAD local estilo Tinkercad com histórico editável, fillet/chanfro, edição de malha e plugins",
  "main": "main.js",
  "author": {
    "name": "Luiz Pacheco",
    "email": "luizgpf@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "prestart": "node scripts/vendor.mjs",
    "start": "electron .",
    "test": "node test/nucleo.test.mjs",
    "predist": "node scripts/vendor.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "icone": "node scripts/icone/modelo.mjs && electron scripts/icone/render.js && python scripts/icone/enquadrar.py",
    "dist:mac": "electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "manifold-3d": "3.5.4",
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "opentype.js": "^1.3.4",
    "three": "0.186.1"
  },
  "build": {
    "appId": "br.luizpacheco.anvil3d",
    "productName": "Anvil3D",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "plugins/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "nvl3d",
        "name": "Projeto Anvil3D",
        "description": "Projeto Anvil3D",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE"
        },
        {
          "from": "EXCECAO-PLUGINS.md",
          "to": "EXCECAO-PLUGINS.md"
        }
      ],
      "artifactName": "${productName}-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Anvil3D",
      "artifactName": "${productName}-Instalador-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portatil-${version}.${ext}"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "copyright": "© 2026 Luiz Pacheco · nobetteridea.com",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icone-1024.png",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-Mac-${version}.${ext}",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "LICENSE",
          "to": "LICENSE"
        },
        {
          "from": "EXCECAO-PLUGINS.md",
          "to": "EXCECAO-PLUGINS.md"
        }
      ]
    },
    "dmg": {
      "title": "Anvil3D ${version}",
      "artifactName": "${productName}-Mac-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/lgpf/anvil3d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgpf/anvil3d.git"
  },
  "funding": "https://ko-fi.com/anvil3d",
  "bugs": {
    "url": "https://github.com/lgpf/anvil3d/issues"
  }
}
